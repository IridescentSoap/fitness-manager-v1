APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
APP_DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
SCHEDULE_HORIZON_DAYS=365
SESSION_IDLE_HOURS=12
# Include this PC's LAN IPv4 (ipconfig). Other devices open http://<that-ip>:8080 — not their own IP.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.x.x
LOG_LEVEL=INFO
APP_VERSION=1.0.0
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=60
